			]
			description: [
				"&6Campfires&r have a new effect - every &afriendly mob&r around it will get a new effect, &eCozy Campfire&r, which will slowly &cregenerate&r lost life."
				""
				"Natural regeneration is way slower in ADJ than in vanilla Minecraft. Investing in alternate sources is vital if you want to stay topped off!"
				""
				"Unrelated, but you can right click any campfire to toggle between its lit and unlit state. No need for Shovels, Water or Flint and Steel."
			]
			entity_vis_size: 1.0f
			id: "282EF85EE78976F5"
			optional: true
			shape: "rsquare"
			subtitle: "Place down a Campfire"
